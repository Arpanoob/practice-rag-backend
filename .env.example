# ─── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed CORS origins (no wildcard in production)
CORS_ORIGIN=http://localhost:5173

# Max request body size
BODY_LIMIT=256kb

# ─── Admin / security ──────────────────────────────────────
# Required to call destructive endpoints (DELETE /api/search/flush).
# If unset, those endpoints are DISABLED. Generate a strong random value.
# ADMIN_TOKEN=change-me-to-a-long-random-secret

# ─── Rate limiting (fixed window, per IP) ──────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=60

# ─── Qdrant vector database ────────────────────────────────
QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=
QDRANT_COLLECTION=youtube_transcripts
EMBED_DIM=768

# ─── LLM / embeddings (Ollama, OpenAI-compatible API) ──────
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama
EMBED_MODEL=nomic-embed-text
LLM_MODEL=llama3.2

# ─── YouTube Transcript Options (Bypasses Datacenter IP restrictions) ───
# Optional YouTube session cookie string (e.g. VISITOR_INFO1_LIVE=...; PREF=...;)
# YOUTUBE_COOKIE=
# Optional proxy URL (e.g. http://username:password@proxy_host:port)
# YOUTUBE_PROXY=

